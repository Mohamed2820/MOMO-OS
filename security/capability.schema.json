{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-os.example/schemas/capability.schema.json",
  "title": "MOMO Capability Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant_id", "subject", "action", "resource", "risk", "expires_at", "approval_mode"],
  "properties": {
    "grant_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "resource": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["public", "personal", "sensitive", "restricted"]},
    "risk": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "max_uses": {"type": "integer", "minimum": 1},
    "approval_mode": {"enum": ["per_call", "standing_scoped", "never_allowed"]},
    "constraints": {"type": "object", "additionalProperties": true}
  }
}
