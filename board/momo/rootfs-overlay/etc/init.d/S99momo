#!/bin/sh
#
# MOMO OS first-boot initialization.
#
case "$1" in
  start)
    echo ""
    echo "=============================================="
    echo "              MOMO OS 0.1.0-alpha"
    echo "       Adaptive computing platform"
    echo "=============================================="
    mkdir -p /var/lib/momo
    chmod 700 /var/lib/momo
    if ! /usr/bin/momoctl boot-check; then
      echo "[MOMO] Boot checks failed; entering degraded state."
      exit 1
    fi
    echo "[MOMO] Boot initialization complete."
    ;;
  stop)
    echo "[MOMO] Shutdown requested."
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
